rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Scheme CMS imagery — public read, authenticated (admin) write.
    match /schemes/{schemeId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Blog CMS imagery. Previously unmatched, so every blog image upload was
    // denied by default — this is why blog cover/inner images never appeared.
    match /blogs/{blogId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Career applicant résumés. Written server-side by /api/careers/apply.
    // Not publicly readable: the file is reached through the signed download
    // URL emailed to the careers inbox, never listed or guessed.
    match /resumes/{fileName} {
      allow read: if false;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (
                     request.resource.contentType == 'application/pdf'
                     || request.resource.contentType == 'application/msword'
                     || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                   );
    }
  }
}
